root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ktlint settings. The Android Studio code style is used so import ordering and
# formatting match what Android Studio produces for Compose code.
[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
# @Composable functions are PascalCase by convention; do not flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,md}]
indent_size = 2
