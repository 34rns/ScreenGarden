    <string name="onboarding_garden_title">Grow something calm</string>
    <string name="onboarding_garden_body">ScreenGarden turns the time you spend away from your phone into a small garden. Focus sessions and quiet days help it grow, and nothing here rushes you.</string>

    <string name="onboarding_privacy_title">Nothing leaves your phone</string>
    <string name="onboarding_privacy_body">No account, no cloud, no internet permission. Your screen time is read on this device, stored on this device, and stays yours to delete.</string>

    <string name="onboarding_usage_title">One permission, one purpose</string>
    <string name="onboarding_usage_body">Android only shares screen time through Usage access. ScreenGarden reads it to draw your day and water your plants, and nothing is uploaded or shared.</string>
    <string name="onboarding_usage_open_settings">Open Usage access settings</string>
    <string name="onboarding_usage_granted">Usage access is on. Thank you.</string>
    <string name="onboarding_usage_not_granted">Usage access is off.</string>
    <string name="onboarding_usage_skip">Skip for now</string>
    <string name="onboarding_usage_skip_explanation">Without it your garden stays empty: no screen time, no gentle limits and no plants. You can grant it later in Settings.</string>

    <string name="onboarding_notifications_title">A gentle nudge, if you want one</string>
    <string name="onboarding_notifications_body">Reminders stay off by default. Allowing notifications lets ScreenGarden quietly tell you when a focus session ends. Nothing else is ever sent.</string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_not_now">Not now</string>

    <string name="onboarding_goals_title">Set a kind baseline</string>
    <string name="onboarding_goals_body">These are goals, not rules. You can change every one of them later in Settings.</string>
    <string name="onboarding_goal_screen_time">Screen time per day</string>
    <string name="onboarding_goal_pickups">Pickups per day</string>
    <string name="onboarding_goal_bedtime_start">Bedtime starts</string>
    <string name="onboarding_goal_bedtime_end">Bedtime ends</string>
