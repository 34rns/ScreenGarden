<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform-only theme: no AppCompat / Material Components dependency.
        Compose paints the real UI; this style just keeps the launch frame calm.
    -->
    <style name="Theme.ScreenGarden" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sg_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
