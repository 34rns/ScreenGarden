<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ScreenGarden is deliberately offline-capable and privacy-first.
        HARD RULE: this manifest must never request the INTERNET permission,
        directly or through a tools:node merge. See AGENT_MEMORY.txt - HARD
        RULES and PERMISSIONS.
    -->

    <!--
        Usage access (SECTION 9). PACKAGE_USAGE_STATS is a signature|privileged
        permission: declaring it does not grant anything, and the user must still
        switch ScreenGarden on in Settings > Special app access > Usage access.
        Without the declaration the AppOps check cannot succeed on any device.
        lint's ProtectedPermissions warning is expected for exactly this reason.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Reminders (SECTION 9). The first-run flow offers the Android 13+ prompt and
        stores the answer as `notificationsOn`; denying it changes nothing else, and
        older platforms never see this permission at all. No notification is posted
        yet - the focus reminders that will use it arrive in P12/P16.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        WorkManager (P06) merges its own permissions into this manifest. Two of them
        are ones this app never uses, so they are removed here rather than silently
        shipped:
        - ACCESS_NETWORK_STATE: only needed by network-constrained work; every
          constraint we set is local (battery), and an offline-first app must not
          even look like it watches connectivity (SECTION 9).
        WAKE_LOCK and RECEIVE_BOOT_COMPLETED stay: the first lets the worker finish
        once started, the second lets WorkManager reschedule the periodic sync after
        a reboot. Both are documented in SECTION 9.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <!-- P12 user-started focus countdown; justified in memory SECTION 9. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        Launcher-app visibility on API 30+. Reading usage stats gives package
        names, but PackageManager only resolves apps this app can see, and the
        screen-time list must exclude packages without a launcher icon. A narrow
        <queries> block is the approved alternative to QUERY_ALL_PACKAGES (SECTION 9).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        android:allowBackup="false" is a HARD RULE: screen time data never leaves
        the device through cloud backup or device-to-device transfer, so no
        dataExtractionRules / fullBackupContent resource is declared.
        android:label on <application> covers the activity too.
    -->
    <application
        android:name=".ScreenGardenApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenGarden">

        <service
            android:name=".data.focus.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started offline focus countdown with an ongoing notification and stop action" />
        </service>
        <receiver android:name=".data.focus.FocusBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenGarden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
